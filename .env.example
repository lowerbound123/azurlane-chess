# Node.js 25. Leave HOST at loopback behind a reverse proxy, or bind to 0.0.0.0 for LAN access.
HOST=127.0.0.1
PORT=3000
# Exact browser origins allowed to use this service, comma-separated.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# 账号功能默认停用；改为 true 后重启服务即可启用，无需重新构建。
AUTH_ENABLED=false
# 账号、会话及已结束战绩的 SQLite 文件；默认使用仓库 data/accounts.sqlite。
# 保持在私有持久目录，禁止放入 dist/ 或 public/；停用时不会创建数据库。
# AUTH_DB_PATH=data/accounts.sqlite
# HTTPS 部署保持 true；仅本地 HTTP 验收时显式改为 false。
AUTH_COOKIE_SECURE=true
# 默认使用 DeepSeek 官方 API，游戏内名称“小肥鱼”。填入密钥后启用。
DEEPSEEK_FLASH_API_KEY=
# 自定义模型列表（可选；不指定且本地文件不存在时使用内置示例列表）
# AI_MODELS_FILE=config/ai-models.json
# 环境变量 = model_id 转大写、非字母数字下划线替换为下划线，再加 _API_KEY

# 资源存储默认 local；复制 config/asset-storage.example.json 为私有配置后选择 s3 / oss / cos。
# 默认文件 config/asset-storage.json 不存在时使用 local；显式指定的文件不存在会阻止启动。
# 配置文件必须位于 dist、public 和 .generated/public 以外，禁止提交真实凭据。
# ASSET_STORAGE_CONFIG=config/asset-storage.json
# 环境变量优先于配置文件内联凭据；以下密钥仅供服务端 GET 签名，浏览器不接收密钥。
# ASSET_ACCESS_KEY_ID=
# ASSET_SECRET_ACCESS_KEY=
# S3 兼容使用 endpoint，可设置 forcePathStyle；OSS 绑定域名使用 endpoint + cname:true。
# COS 绑定域名填 endpoint，bucket 含 APPID；region 例：ap-guangzhou。
# OSS region 例：oss-cn-hangzhou。默认 URL 有效期 3600 秒，过期后才更新。
# 仅手动上传运行清单的对象；本配置不会上传或删除云端文件。
