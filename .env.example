# Node.js 25. Leave HOST at loopback behind a reverse proxy, or bind to 0.0.0.0 for LAN access.
HOST=127.0.0.1
PORT=3000
# Exact browser origins allowed to use this service, comma-separated.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Copy config/ai-models.example.json to config/ai-models.json and enable wanted models.
# AI_MODELS_FILE=config/ai-models.json
# AI_CHAT_API_KEY=your-key
# AI_RESPONSES_API_KEY=your-key
