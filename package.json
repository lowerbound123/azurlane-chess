{
  "name": "azurlane-chess",
  "version": "0.8.3",
  "type": "module",
  "scripts": {
    "dev": "npm run assets:prepare && vite --host 0.0.0.0 --port 4173",
    "build": "npm run assets:prepare && node scripts/generate-contracts.mjs && vite build && npm run build:server",
    "test": "npm run assets:prepare && vitest run",
    "version:next": "node scripts/bump-version.mjs",
    "build:pages": "npm run assets:prepare && vite build --base=/azurlane-chess/",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test:server": "vitest run tests/server-*.test.ts",
    "typecheck": "npm run assets:prepare && vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:spine": "node scripts/render-spine-previews.mjs && npm run assets:generate && npm run assets:prepare",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:sync": "node --env-file-if-exists=.env scripts/sync-assets.ts",
    "assets:fetch": "node scripts/fetch-ship-assets.mjs",
    "assets:check": "node scripts/fetch-ship-assets.mjs --check",
    "demos:render": "node scripts/render-ability-demos.mjs",
    "demos:check": "node scripts/render-ability-demos.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/websocket": "^11.3.3",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "15.0.0",
    "ali-oss": "^6.23.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "fastify": "^5.12.5",
    "pinia": "4.0.3",
    "piscina": "5.3.2",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "three": "0.184.0",
    "tw-animate-css": "1.4.0",
    "typebox": "1.3.35",
    "vue": "^3.5.18",
    "vue-router": "4.6.4",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "25.9.9",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "^20.14.5",
    "shadcn-vue": "2.8.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^6.1.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": ">=25 <26"
  }
}
